rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }
    function getUserRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function hasRole(role) { return isAuthenticated() && ((request.auth.token.role != null && request.auth.token.role == role) || getUserRole() == role); }
    function isSuperAdmin() { return isAuthenticated() && request.auth.token.role == 'super_admin'; }

    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create: if isOwner(userId) && request.resource.data.role in ['student', 'institution', 'employer'];
      allow update: if isSuperAdmin() || (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'verified', 'admin', 'superAdmin']));
      allow delete: if isSuperAdmin();
    }

    match /employers/{employerId} {
      allow read: if isAuthenticated() && (resource.data.verificationStatus == 'verified' || isOwner(employerId) || isSuperAdmin());
      allow create: if isOwner(employerId) && hasRole('employer');
      allow update: if isSuperAdmin() || (isOwner(employerId) && hasRole('employer') && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationStatus', 'verified', 'tier']));
      allow delete: if isSuperAdmin();
    }

    match /institutions/{institutionId} {
      allow read: if isAuthenticated() && (resource.data.empanelmentStatus == 'empanelled' || isOwner(institutionId) || isSuperAdmin());
      allow create: if isOwner(institutionId) && hasRole('institution');
      allow update: if isSuperAdmin() || (isOwner(institutionId) && hasRole('institution') && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['empanelmentStatus', 'verified', 'verifiedByAdmin']));
      allow delete: if isSuperAdmin();
    }

    match /students/{studentId} {
      allow read: if isOwner(studentId) || isSuperAdmin() || (hasRole('institution') && resource.data.institutionId == request.auth.uid);
      allow create: if isOwner(studentId) && hasRole('student');
      allow update: if isSuperAdmin() ||
        (isOwner(studentId) && hasRole('student') && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['platformVerificationStatus', 'institutionVerificationStatus'])) ||
        (hasRole('institution') && resource.data.institutionId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['institutionVerificationStatus', 'verificationNotes', 'updatedAt']));
      allow delete: if isSuperAdmin();
    }

    match /candidateProfiles/{profileId} {
      allow read: if isSuperAdmin() ||
        (hasRole('employer') && resource.data.employerId == request.auth.uid) ||
        (hasRole('student') && resource.data.studentId == request.auth.uid);
      allow create: if isSuperAdmin() || (hasRole('employer') && request.resource.data.employerId == request.auth.uid && request.resource.data.studentId is string);
      allow update: if isSuperAdmin() || (hasRole('employer') && resource.data.employerId == request.auth.uid);
      allow delete: if isSuperAdmin() || (hasRole('employer') && resource.data.employerId == request.auth.uid);
    }

    match /requirements/{requirementId} {
      allow read: if isSuperAdmin() || (hasRole('employer') && resource.data.employerId == request.auth.uid);
      allow create: if hasRole('employer') && request.resource.data.employerId == request.auth.uid;
      allow update: if isSuperAdmin() || (hasRole('employer') && resource.data.employerId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    match /campaigns/{campaignId} {
      allow read: if isSuperAdmin() || (hasRole('employer') && resource.data.employerId == request.auth.uid) || (hasRole('institution') && resource.data.targetedInstitutionIds.hasAny([request.auth.uid]));
      allow create: if hasRole('employer') && request.resource.data.employerId == request.auth.uid;
      allow update: if isSuperAdmin() || (hasRole('employer') && resource.data.employerId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    match /calls/{callId} {
      allow read: if isSuperAdmin() || (hasRole('employer') && resource.data.employerId == request.auth.uid) || (hasRole('institution') && resource.data.institutionId == request.auth.uid);
      allow create: if hasRole('employer') && request.resource.data.employerId == request.auth.uid;
      allow update: if isSuperAdmin() || (hasRole('employer') && resource.data.employerId == request.auth.uid) || (hasRole('institution') && resource.data.institutionId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    match /opportunities/{opportunityId} {
      allow read: if isSuperAdmin() ||
        (hasRole('employer') && resource.data.employerId == request.auth.uid) ||
        (hasRole('student') && resource.data.studentId == request.auth.uid) ||
        (hasRole('institution') && resource.data.institutionId == request.auth.uid);
      allow create: if isSuperAdmin() ||
        (hasRole('employer') && request.resource.data.employerId == request.auth.uid) ||
        (hasRole('institution') && request.resource.data.institutionId == request.auth.uid);
      allow update: if isSuperAdmin() ||
        (hasRole('employer') && resource.data.employerId == request.auth.uid) ||
        (hasRole('institution') && resource.data.institutionId == request.auth.uid) ||
        (hasRole('student') && resource.data.studentId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stage', 'consentedAt', 'stageUpdatedAt']));
      allow delete: if isSuperAdmin();
    }

    match /system/{document=**} { allow read, write: if isSuperAdmin(); }
  }
}
