rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }
    function getUserRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function hasRole(role) { return isAuthenticated() && ((request.auth.token.role != null && request.auth.token.role == role) || getUserRole() == role); }
    function isSuperAdmin() { return isAuthenticated() && request.auth.token.role == 'super_admin'; }
    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create: if isOwner(userId) && request.resource.data.role in ['student', 'institution', 'employer'];
      allow update: if isSuperAdmin() || (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'verified', 'admin', 'superAdmin']));
      allow delete: if isSuperAdmin();
    }
    match /employers/{employerId} {
      allow read: if isAuthenticated() && (resource.data.verificationStatus == 'verified' || isOwner(employerId) || isSuperAdmin());
      allow create: if isOwner(employerId) && hasRole('employer');
      allow update: if isSuperAdmin() || (isOwner(employerId) && hasRole('employer') && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'verificationStatus', 'verified', 'tier', 'verifiedByAdmin']));
      allow delete: if isSuperAdmin();
    }
    match /institutions/{institutionId} {
      allow read: if isAuthenticated() && (resource.data.empanelmentStatus == 'empanelled' || isOwner(institutionId) || isSuperAdmin());
      allow create: if isOwner(institutionId) && hasRole('institution');
      allow update: if isSuperAdmin() || (isOwner(institutionId) && hasRole('institution') && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'empanelmentStatus', 'verified', 'verifiedByAdmin', 'tier']));
      allow delete: if isSuperAdmin();
    }
    match /students/{studentId} {
      allow read: if isOwner(studentId) || isSuperAdmin() || (hasRole('institution') && resource.data.institutionId == request.auth.uid);
      allow create: if isOwner(studentId) && hasRole('student');
      allow update: if isSuperAdmin() || (isOwner(studentId) && hasRole('student') && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'platformVerificationStatus', 'institutionVerificationStatus', 'verificationNotes', 'campaignConsents', 'consentAuditTrail', 'placementStatus', 'placedCompany', 'placedSalaryLPA'])) || (hasRole('institution') && resource.data.institutionId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['institutionVerificationStatus', 'verificationNotes', 'updatedAt']));
      allow delete: if isSuperAdmin();
    }
    match /careerEvidence/{evidenceId} {
      allow read: if isSuperAdmin() || (hasRole('student') && resource.data.studentId == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /candidateProfiles/{profileId} {
      allow read: if isSuperAdmin() || (hasRole('employer') && resource.data.employerId == request.auth.uid && get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.campaignConsents[resource.data.campaignId].status == 'approved') || (hasRole('student') && resource.data.studentId == request.auth.uid);
      allow create, update, delete: if isSuperAdmin();
    }
    match /auditEvents/{eventId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }
    match /requirements/{requirementId} {
      allow read: if isSuperAdmin() || (hasRole('employer') && resource.data.employerId == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /campaigns/{campaignId} {
      allow read: if isSuperAdmin() || (hasRole('employer') && resource.data.employerId == request.auth.uid) || (hasRole('institution') && resource.data.targetedInstitutionIds.hasAny([request.auth.uid]));
      allow create, update, delete: if false;
    }
    match /calls/{callId} {
      allow read: if isSuperAdmin() || (hasRole('employer') && resource.data.employerId == request.auth.uid) || (hasRole('institution') && resource.data.institutionId == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /opportunities/{opportunityId} {
      allow read: if isSuperAdmin() || (hasRole('employer') && resource.data.employerId == request.auth.uid) || (hasRole('student') && resource.data.studentId == request.auth.uid) || (hasRole('institution') && resource.data.institutionId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Commercial records are server-owned. Clients may read their own commercial
    // account and billing records, but cannot manufacture invoices, payments,
    // subscriptions, campaign charges, or success fees from the browser.
    match /commercialAccounts/{accountId} {
      allow read: if isSuperAdmin() || resource.data.ownerUid == request.auth.uid;
      allow create, update, delete: if false;
    }
    match /subscriptions/{subscriptionId} {
      allow read: if isSuperAdmin() || resource.data.ownerUid == request.auth.uid;
      allow create, update, delete: if false;
    }
    match /campaignCharges/{chargeId} {
      allow read: if isSuperAdmin() || resource.data.employerId == request.auth.uid;
      allow create, update, delete: if false;
    }
    match /successFees/{feeId} {
      allow read: if isSuperAdmin() || resource.data.employerId == request.auth.uid;
      allow create, update, delete: if false;
    }
    match /invoices/{invoiceId} {
      allow read: if isSuperAdmin() || resource.data.ownerUid == request.auth.uid;
      allow create, update, delete: if false;
    }
    match /billingEvents/{eventId} {
      allow read: if isSuperAdmin() || resource.data.ownerUid == request.auth.uid;
      allow create, update, delete: if false;
    }
    match /system/{document=**} { allow read, write: if isSuperAdmin(); }
  }
}
