generator client {
  provider = "prisma-client-js"
  output   = "../../generated/control-plane"
}

datasource db {
  provider = "postgresql"
  url      = env("CONTROL_DATABASE_URL")
}

// Global control-plane records only. Keep this client on the explicitly configured control schema.
model Tenant {
  id            String       @id @default(cuid())
  slug          String       @unique @db.VarChar(63)
  displayName   String       @map("display_name") @db.VarChar(160)
  schemaName    String       @unique @map("schema_name") @db.VarChar(63)
  canonicalHost String?      @unique @map("canonical_host") @db.VarChar(255)
  status        TenantStatus @default(PROVISIONING)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  memberships   Membership[]

  @@index([status, slug])
  @@map("tenants")
}

model UserIdentity {
  id             String       @id @default(cuid())
  externalSubject String      @unique @map("external_subject") @db.VarChar(255)
  email          String?      @unique @db.VarChar(320)
  displayName    String?      @map("display_name") @db.VarChar(160)
  platformRole   PlatformRole? @map("platform_role")
  status         UserStatus   @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  memberships    Membership[]

  @@index([status, email])
  @@map("user_identities")
}

model Membership {
  id          String           @id @default(cuid())
  userId      String           @map("user_id")
  tenantId    String           @map("tenant_id")
  role        TenantRole
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  user        UserIdentity     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId, role])
  @@index([tenantId, status, role])
  @@index([userId, status])
  @@map("memberships")
}

model PlatformAuditEvent {
  id            String   @id @default(cuid())
  actorSubject  String?  @map("actor_subject") @db.VarChar(255)
  tenantId      String?  @map("tenant_id") @db.VarChar(64)
  action        String   @db.VarChar(120)
  resourceType  String   @map("resource_type") @db.VarChar(120)
  resourceId    String?  @map("resource_id") @db.VarChar(255)
  correlationId String   @map("correlation_id") @db.VarChar(128)
  outcome       String   @db.VarChar(32)
  details       Json?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([actorSubject, createdAt])
  @@index([correlationId])
  @@map("platform_audit_events")
}

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum PlatformRole {
  SYSTEM_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum TenantRole {
  UNIVERSITY_ADMIN
  RECRUITER
  STUDENT
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}
