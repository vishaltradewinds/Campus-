# ZERO-COST AI POLICY
# fallback = deterministic, no external AI API and always zero API spend.
# gemini-free = Gemini Free Tier only; requires explicit acknowledgement below.
# ollama = local/open model through Ollama; no hosted model API cost.
AI_MODE="fallback"
AI_ZERO_COST_ACK="false"

# Only used when AI_MODE="gemini-free".
# Keep server-side only.
GEMINI_API_KEY="MY_GEMINI_FREE_TIER_KEY"

# Only used when AI_MODE="ollama".
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="gemma4"

APP_URL="MY_APP_URL"

# Firebase Client Configuration (public browser configuration)
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_project_id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
VITE_FIREBASE_APP_ID="your_app_id"

# Server-side Firebase token verification. This is a Firebase Web API key and
# is not a secret, but keep it explicit so the server does not depend on a
# client-only variable being present at runtime.
FIREBASE_WEB_API_KEY="your_firebase_web_api_key"
